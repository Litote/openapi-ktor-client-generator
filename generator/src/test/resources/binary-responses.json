{
  "openapi": "3.0.3",
  "info": {
    "title": "Binary responses API",
    "version": "1.0.0"
  },
  "paths": {
    "/files/{id}": {
      "get": {
        "tags": ["files"],
        "operationId": "downloadFile",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "File content",
            "content": {
              "application/octet-stream": {}
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/images/{id}": {
      "get": {
        "tags": ["files"],
        "operationId": "getImage",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Image",
            "content": {
              "image/png": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          }
        }
      }
    },
    "/report": {
      "get": {
        "tags": ["files"],
        "operationId": "getReport",
        "responses": {
          "200": {
            "description": "Plain text report",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/export": {
      "get": {
        "tags": ["files"],
        "operationId": "exportCsv",
        "responses": {
          "200": {
            "description": "CSV export",
            "content": {
              "text/csv; charset=utf-8": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/download": {
      "get": {
        "tags": ["files"],
        "operationId": "download",
        "responses": {
          "200": {
            "description": "Any content",
            "content": {
              "*/*": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          }
        }
      }
    },
    "/documents/{id}": {
      "get": {
        "tags": ["files"],
        "operationId": "getDocument",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Document metadata as JSON or the PDF itself",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Document" }
              },
              "application/pdf": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": { "type": "string" }
        }
      },
      "Document": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" }
        }
      }
    }
  }
}
