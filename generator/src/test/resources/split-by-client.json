{
  "openapi": "3.0.3",
  "info": {
    "title": "Split-by-client test API",
    "version": "1.0.0"
  },
  "paths": {
    "/users": {
      "get": {
        "tags": ["User"],
        "summary": "Get all users",
        "operationId": "getUsers",
        "responses": {
          "200": {
            "description": "List of users",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "get": {
        "tags": ["Order"],
        "summary": "Get all orders",
        "operationId": "getOrders",
        "responses": {
          "200": {
            "description": "List of orders",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Address": {
        "type": "object",
        "description": "Shared model used by both UserResponse and OrderResponse",
        "properties": {
          "street": {"type": "string"},
          "city": {"type": "string"}
        },
        "required": ["street", "city"]
      },
      "UserResponse": {
        "type": "object",
        "description": "Private model: only used by UserClient",
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "name": {"type": "string"},
          "address": {"$ref": "#/components/schemas/Address"}
        },
        "required": ["id", "name", "address"]
      },
      "OrderResponse": {
        "type": "object",
        "description": "Private model: only used by OrderClient",
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "item": {"type": "string"},
          "shippingAddress": {"$ref": "#/components/schemas/Address"}
        },
        "required": ["id", "item", "shippingAddress"]
      }
    }
  }
}
