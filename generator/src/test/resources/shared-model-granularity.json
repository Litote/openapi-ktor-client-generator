{
  "openapi": "3.0.3",
  "info": {
    "title": "Shared model granularity test API",
    "version": "1.0.0"
  },
  "paths": {
    "/users": {
      "get": {
        "tags": ["User"],
        "summary": "Get all users",
        "operationId": "getUsers",
        "responses": {
          "200": {
            "description": "List of users",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponse" }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "get": {
        "tags": ["Order"],
        "summary": "Get all orders",
        "operationId": "getOrders",
        "responses": {
          "200": {
            "description": "List of orders",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OrderResponse" }
              }
            }
          }
        }
      }
    },
    "/products": {
      "get": {
        "tags": ["Product"],
        "summary": "Get all products",
        "operationId": "getProducts",
        "responses": {
          "200": {
            "description": "List of products",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Address": {
        "type": "object",
        "description": "Shared model used by UserResponse and OrderResponse (group: User+Order)",
        "properties": {
          "street": { "type": "string" },
          "city": { "type": "string" }
        },
        "required": ["street", "city"]
      },
      "Category": {
        "type": "object",
        "description": "Shared model used by OrderResponse and ProductResponse (group: Order+Product)",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" }
        },
        "required": ["id", "name"]
      },
      "UserResponse": {
        "type": "object",
        "description": "Private model: only used by UserClient",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" },
          "address": { "$ref": "#/components/schemas/Address" }
        },
        "required": ["id", "name", "address"]
      },
      "OrderResponse": {
        "type": "object",
        "description": "Private model: only used by OrderClient",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "item": { "type": "string" },
          "shippingAddress": { "$ref": "#/components/schemas/Address" },
          "category": { "$ref": "#/components/schemas/Category" }
        },
        "required": ["id", "item", "shippingAddress", "category"]
      },
      "ProductResponse": {
        "type": "object",
        "description": "Private model: only used by ProductClient",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" },
          "category": { "$ref": "#/components/schemas/Category" }
        },
        "required": ["id", "name", "category"]
      }
    }
  }
}
