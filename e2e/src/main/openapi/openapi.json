{
  "openapi": "3.0.3",
  "info": {
    "title": "Simple test API",
    "version": "1.0.0"
  },
  "paths": {
    "/test": {
      "post": {
        "summary": "Create a test",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TestRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestResponse"
                }
              }
            }
          }
        }
      }
    },
    "/test-status": {
      "get": {
        "summary": "Get test status",
        "responses": {
          "200": {
            "description": "Status of the test",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestStatusResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "runId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "day",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "default": "2024-01-31"
            }
          },
          {
            "name": "runIds",
            "in": "query",
            "schema": { "type": "array", "items": { "type": "string", "format": "uuid" } }
          },
          {
            "name": "statuses",
            "in": "query",
            "style": "pipeDelimited",
            "explode": false,
            "schema": { "type": "array", "items": { "type": "string", "enum": ["PENDING", "RUNNING"] } }
          },
          {
            "name": "filter",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "minId": { "type": "integer" }
              }
            }
          },
          {
            "name": "range",
            "in": "query",
            "schema": { "$ref": "#/components/schemas/TestRange" }
          },
          {
            "name": "compactRange",
            "in": "query",
            "explode": false,
            "schema": { "$ref": "#/components/schemas/TestRange" }
          },
          {
            "name": "states",
            "in": "query",
            "schema": { "type": "array", "items": { "$ref": "#/components/schemas/TestStatusEnum" } }
          },
          {
            "name": "X-Trace-Ids",
            "in": "header",
            "schema": { "type": "array", "items": { "type": "string" } }
          },
          {
            "name": "session",
            "in": "cookie",
            "required": true,
            "schema": { "type": "string" }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "TestRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": ["name"]
      },
      "TestResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["id", "name"]
      },
      "TestStatusResponse": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/TestStatusEnum"
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "day": {
            "type": "string",
            "format": "date"
          },
          "runId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["status"]
      },
      "TestRange": {
        "type": "object",
        "properties": {
          "from": { "type": "integer" },
          "to": { "type": "integer" }
        }
      },
      "TestStatusEnum": {
        "type": "string",
        "enum": ["PENDING", "RUNNING", "SUCCESS", "FAILED"]
      }
    }
  }
}
